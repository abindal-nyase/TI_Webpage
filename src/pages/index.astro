---
/*
 * index.astro — NYA Tenant Improvement landing page
 *
 * Locked to the default color scheme + font pair (DEFAULT_SCHEME / DEFAULT_FONT
 * below), set statically on :root in <head>. The runtime theme switcher was
 * removed for production; explore alternate schemes/fonts in /style-explorer.
 *
 * Color schemes: navy-blue | slate-amber | charcoal-cyan | forest-stone | violet-gold | navy-gold | maroon-gold
 * Font pairs:    playfair-inter | fraunces-jakarta | cormorant-montserrat | baskerville-source | spectral-work
 */
import '../index.css';
import GlobalSetup from '../components/GlobalSetup/GlobalSetup';
import O3Hero from '../components/ti-option3/00_O3_Hero/00_O3_Hero.jsx';
import O3TIDifferences from '../components/ti-option3/01_O3_TIDifferences/01_O3_TIDifferences';
import O3FirmCulture from '../components/ti-option3/02_O3_FirmCulture/02_O3_FirmCulture';
import O3TrustWall from '../components/ti-option3/03_O3_TrustWall/03_O3_TrustWall';
import O3ClientCare from '../components/ti-option3/04_O3_ClientCare/04_O3_ClientCare.jsx';
import O3Ethos from '../components/ti-option3/05_O3_Ethos/05_O3_Ethos.jsx';
import O3Footer from '../components/ti-option3/06_O3_Footer/06_O3_Footer';
import O3SideNav from '../components/ti-option3/O3_SideNav/O3_SideNav';
import SectionTheme from '../components/ti-option3/SectionTheme.astro';

// Hero building base layers — preloaded in <head> so the browser starts
// fetching the ~4.7MB stack at HTML-parse time (in parallel with the JS
// bundle + fonts) instead of waiting for the Hero component to hydrate.
// Same hashed URLs the component imports, so the <img src> hits cache.
// Hover variants are intentionally NOT preloaded (deferred, never shown at load).
import heroI1 from '../assets/hero-images/i1.webp?url';
import heroI2 from '../assets/hero-images/i2.webp?url';
import heroI3 from '../assets/hero-images/i3.webp?url';
import heroI4 from '../assets/hero-images/i4.webp?url';
import heroI5 from '../assets/hero-images/i5.webp?url';
import heroI6 from '../assets/hero-images/i6.webp?url';
import heroI7 from '../assets/hero-images/i7.webp?url';
import heroI8 from '../assets/hero-images/i8.webp?url';
const heroBaseImages = [heroI1, heroI2, heroI3, heroI4, heroI5, heroI6, heroI7, heroI8];

/*
 * Theme tokens — single source of truth for the color schemes and font pairs.
 * The default (DEFAULT_SCHEME / DEFAULT_FONT) is locked onto :root; any other
 * scheme/font is reachable per-section via <SectionTheme> and its generated
 * [data-scheme]/[data-font] rules. Edit values here only.
 */
const SCHEMES = [
  { id: 'navy-blue',     vars: { '--color-primary': 'oklch(0.24 0.0598 257.3015)', '--color-primary-light': 'oklch(0.3462 0.0736 256.0397)', '--color-accent': 'oklch(0.6093 0.1819 257.2923)', '--color-accent-hover': 'oklch(0.5496 0.1758 256.9261)', '--border-accent': 'oklch(0.6093 0.1819 257.2923 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6093 0.1819 257.2923 / 0.28)' } },
  { id: 'slate-amber',   vars: { '--color-primary': 'oklch(0.2781 0.0296 256.848)', '--color-primary-light': 'oklch(0.3729 0.0306 259.7328)', '--color-accent': 'oklch(0.6658 0.1574 58.3183)', '--color-accent-hover': 'oklch(0.5553 0.1455 48.9975)', '--border-accent': 'oklch(0.6658 0.1574 58.3183 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6658 0.1574 58.3183 / 0.28)' } },
  { id: 'charcoal-cyan', vars: { '--color-primary': 'oklch(0.2077 0.0398 265.7549)', '--color-primary-light': 'oklch(0.2795 0.0368 260.031)', '--color-accent': 'oklch(0.7148 0.1257 215.2209)', '--color-accent-hover': 'oklch(0.6089 0.1109 221.7231)', '--border-accent': 'oklch(0.7148 0.1257 215.2209 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.7148 0.1257 215.2209 / 0.28)' } },
  { id: 'forest-stone',  vars: { '--color-primary': 'oklch(0.2776 0.0445 144.2604)', '--color-primary-light': 'oklch(0.3774 0.0598 144.2766)', '--color-accent': 'oklch(0.6421 0.0875 144.4721)', '--color-accent-hover': 'oklch(0.5859 0.089 144.3358)', '--border-accent': 'oklch(0.6421 0.0875 144.4721 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6421 0.0875 144.4721 / 0.28)' } },
  { id: 'violet-gold',   vars: { '--color-primary': 'oklch(0.2573 0.0861 281.2883)', '--color-primary-light': 'oklch(0.3796 0.1783 293.7446)', '--color-accent': 'oklch(0.5413 0.2466 293.009)', '--color-accent-hover': 'oklch(0.4907 0.2412 292.5809)', '--border-accent': 'oklch(0.5413 0.2466 293.009 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.5413 0.2466 293.009 / 0.28)' } },
  { id: 'navy-gold',     vars: { '--color-primary': 'oklch(0.3791 0.1378 265.5222)', '--color-primary-light': 'oklch(0.4244 0.1809 265.6377)', '--color-accent': 'oklch(0.5553 0.1455 48.9975)', '--color-accent-hover': 'oklch(0.4732 0.1247 46.2007)', '--border-accent': 'oklch(0.5553 0.1455 48.9975 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.5553 0.1455 48.9975 / 0.28)' } },
  { id: 'maroon-gold',   vars: { '--color-primary': 'oklch(0.3075 0.113 27.0778)', '--color-primary-light': 'oklch(0.3779 0.1355 26.6732)', '--color-accent': 'oklch(0.7034 0.1227 78.072)', '--color-accent-hover': 'oklch(0.6283 0.1163 76.5841)', '--border-accent': 'oklch(0.7034 0.1227 78.072 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.7034 0.1227 78.072 / 0.28)' } },
];

const FONTS = [
  { id: 'playfair-inter',       vars: { '--font-display': "'Playfair Display', Georgia, serif", '--font-body': "'Inter', system-ui, sans-serif" } },
  { id: 'fraunces-jakarta',     vars: { '--font-display': "'Fraunces', Georgia, serif", '--font-body': "'Plus Jakarta Sans', system-ui, sans-serif" } },
  { id: 'cormorant-montserrat', vars: { '--font-display': "'Cormorant Garamond', Georgia, serif", '--font-body': "'Montserrat', system-ui, sans-serif" } },
  { id: 'baskerville-source',   vars: { '--font-display': "'Libre Baskerville', Georgia, serif", '--font-body': "'Source Sans 3', system-ui, sans-serif" } },
  { id: 'spectral-work',        vars: { '--font-display': "'Spectral', Georgia, serif", '--font-body': "'Work Sans', system-ui, sans-serif" } },
];

const DEFAULT_SCHEME = 'charcoal-cyan';
const DEFAULT_FONT = 'spectral-work';

// Theme CSS: lock the default scheme + font onto :root, then emit the
// per-section [data-scheme]/[data-font] override rules (see SectionTheme.astro).
const decls = (vars: Record<string, string>) => Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(';');
const byId = (list: { id: string; vars: Record<string, string> }[], id: string) => list.find((x) => x.id === id);
const themeCss = [
  `:root{${decls(byId(SCHEMES, DEFAULT_SCHEME)!.vars)};${decls(byId(FONTS, DEFAULT_FONT)!.vars)}}`,
  ...SCHEMES.map((s) => `[data-scheme="${s.id}"]{${decls(s.vars)}}`),
  ...FONTS.map((f) => `[data-font="${f.id}"]{${decls(f.vars)}}`),
].join('\n');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>NYA Tenant Improvement</title>

  <!-- Preload hero building base layers (see frontmatter). Starts the large
       webp fetch immediately at parse time so the building paints sooner and
       the un-pinned load window shrinks. -->
  {heroBaseImages.map((href) => (
    <link rel="preload" as="image" href={href} type="image/webp" fetchpriority="high" />
  ))}

  <!-- All font families referenced by SCHEMES/FONTS must be loaded here -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Work+Sans:wght@300;400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fira+Sans:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  />

  <!--
    Theme variables. :root carries the default scheme + font; a section wrapped
    in <SectionTheme scheme="…" font="…"> re-declares them on its own subtree via
    the [data-scheme]/[data-font] rules. Generated from SCHEMES/FONTS above.
  -->
  <style is:global set:html={themeCss}></style>
</head>

<body>
  <GlobalSetup client:load />

  <O3SideNav client:load />

  <!--
    ── Page sections ──
    Each section is wrapped in <SectionTheme>. Add scheme="…" and/or font="…"
    to override the global theme for that section; omit to inherit the global.
    Scheme ids:  navy-blue | slate-amber | charcoal-cyan | forest-stone
                 violet-gold | navy-gold | maroon-gold
    Font ids:    playfair-inter | fraunces-jakarta | cormorant-montserrat
                 baskerville-source | spectral-work
    Section overrides (e.g. section="hero") are defined in SectionTheme.astro.
  -->
  <main style="margin:0;padding:0">
    <SectionTheme section="hero">
      <O3Hero client:load />
    </SectionTheme>
    <SectionTheme section="ti-differences">
      <O3TIDifferences client:load />
    </SectionTheme>
    <SectionTheme>
      <O3FirmCulture client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3TrustWall client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3ClientCare client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3Ethos client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3Footer client:load />
    </SectionTheme>
  </main>
</body>
</html>
