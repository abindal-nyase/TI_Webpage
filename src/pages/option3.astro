---
/*
 * option3.astro — TI Page Option 3 (WIP / Skeleton)
 *
 * Theme switcher bar at top lets you toggle color scheme and font pair.
 * All components read CSS variables from :root — they react to changes automatically.
 *
 * Color schemes: navy-blue | slate-amber | charcoal-cyan | forest-stone | violet-gold | navy-gold | maroon-gold
 * Font pairs:    playfair-inter | fraunces-jakarta | cormorant-montserrat | baskerville-source | spectral-work
 */
import '../index.css';
import GlobalSetup from '../components/GlobalSetup/GlobalSetup';
import O3Hero from '../components/ti-option3/00_O3_Hero/00_O3_Hero.jsx';
import O3TIDifferences from '../components/ti-option3/01_O3_TIDifferences/01_O3_TIDifferences';
import O3FirmCulture from '../components/ti-option3/02_O3_FirmCulture/02_O3_FirmCulture';
import O3TrustWall from '../components/ti-option3/03_O3_TrustWall/03_O3_TrustWall';
import O3ClientCare from '../components/ti-option3/04_O3_ClientCare/04_O3_ClientCare.jsx';
import O3Ethos from '../components/ti-option3/05_O3_Ethos/05_O3_Ethos.jsx';
import O3Footer from '../components/ti-option3/06_O3_Footer/06_O3_Footer';
import O3SideNav from '../components/ti-option3/O3_SideNav/O3_SideNav';
import SectionTheme from '../components/ti-option3/SectionTheme.astro';
import BackToHub from '../components/BackToHub.astro';

// Hero building base layers — preloaded in <head> so the browser starts
// fetching the ~4.7MB stack at HTML-parse time (in parallel with the JS
// bundle + fonts) instead of waiting for the Hero component to hydrate.
// Same hashed URLs the component imports, so the <img src> hits cache.
// Hover variants are intentionally NOT preloaded (deferred, never shown at load).
import heroI1 from '../assets/hero-images/i1.webp?url';
import heroI2 from '../assets/hero-images/i2.webp?url';
import heroI3 from '../assets/hero-images/i3.webp?url';
import heroI4 from '../assets/hero-images/i4.webp?url';
import heroI5 from '../assets/hero-images/i5.webp?url';
import heroI6 from '../assets/hero-images/i6.webp?url';
import heroI7 from '../assets/hero-images/i7.webp?url';
import heroI8 from '../assets/hero-images/i8.webp?url';
const heroBaseImages = [heroI1, heroI2, heroI3, heroI4, heroI5, heroI6, heroI7, heroI8];

/*
 * Single source of truth for the theme switcher.
 * These drive BOTH the scoped CSS rules (generated below) and the client-side
 * switcher script (passed via define:vars) — edit values here only.
 */
const SCHEMES = [
  { id: 'navy-blue',     name: 'NB', swatches: ['oklch(0.24 0.0598 257.3015)', 'oklch(0.6093 0.1819 257.2923)'],
    vars: { '--color-primary': 'oklch(0.24 0.0598 257.3015)', '--color-primary-light': 'oklch(0.3462 0.0736 256.0397)', '--color-accent': 'oklch(0.6093 0.1819 257.2923)', '--color-accent-hover': 'oklch(0.5496 0.1758 256.9261)', '--border-accent': 'oklch(0.6093 0.1819 257.2923 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6093 0.1819 257.2923 / 0.28)' } },
  { id: 'slate-amber',   name: 'SA', swatches: ['oklch(0.2781 0.0296 256.848)', 'oklch(0.6658 0.1574 58.3183)'],
    vars: { '--color-primary': 'oklch(0.2781 0.0296 256.848)', '--color-primary-light': 'oklch(0.3729 0.0306 259.7328)', '--color-accent': 'oklch(0.6658 0.1574 58.3183)', '--color-accent-hover': 'oklch(0.5553 0.1455 48.9975)', '--border-accent': 'oklch(0.6658 0.1574 58.3183 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6658 0.1574 58.3183 / 0.28)' } },
  { id: 'charcoal-cyan', name: 'CC', swatches: ['oklch(0.2077 0.0398 265.7549)', 'oklch(0.7148 0.1257 215.2209)'],
    vars: { '--color-primary': 'oklch(0.2077 0.0398 265.7549)', '--color-primary-light': 'oklch(0.2795 0.0368 260.031)', '--color-accent': 'oklch(0.7148 0.1257 215.2209)', '--color-accent-hover': 'oklch(0.6089 0.1109 221.7231)', '--border-accent': 'oklch(0.7148 0.1257 215.2209 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.7148 0.1257 215.2209 / 0.28)' } },
  { id: 'forest-stone',  name: 'FS', swatches: ['oklch(0.2776 0.0445 144.2604)', 'oklch(0.6421 0.0875 144.4721)'],
    vars: { '--color-primary': 'oklch(0.2776 0.0445 144.2604)', '--color-primary-light': 'oklch(0.3774 0.0598 144.2766)', '--color-accent': 'oklch(0.6421 0.0875 144.4721)', '--color-accent-hover': 'oklch(0.5859 0.089 144.3358)', '--border-accent': 'oklch(0.6421 0.0875 144.4721 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.6421 0.0875 144.4721 / 0.28)' } },
  { id: 'violet-gold',   name: 'V',  swatches: ['oklch(0.2573 0.0861 281.2883)', 'oklch(0.5413 0.2466 293.009)'],
    vars: { '--color-primary': 'oklch(0.2573 0.0861 281.2883)', '--color-primary-light': 'oklch(0.3796 0.1783 293.7446)', '--color-accent': 'oklch(0.5413 0.2466 293.009)', '--color-accent-hover': 'oklch(0.4907 0.2412 292.5809)', '--border-accent': 'oklch(0.5413 0.2466 293.009 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.5413 0.2466 293.009 / 0.28)' } },
  { id: 'navy-gold',     name: 'NG', swatches: ['oklch(0.3791 0.1378 265.5222)', 'oklch(0.5553 0.1455 48.9975)'],
    vars: { '--color-primary': 'oklch(0.3791 0.1378 265.5222)', '--color-primary-light': 'oklch(0.4244 0.1809 265.6377)', '--color-accent': 'oklch(0.5553 0.1455 48.9975)', '--color-accent-hover': 'oklch(0.4732 0.1247 46.2007)', '--border-accent': 'oklch(0.5553 0.1455 48.9975 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.5553 0.1455 48.9975 / 0.28)' } },
  { id: 'maroon-gold',   name: 'MG', swatches: ['oklch(0.3075 0.113 27.0778)', 'oklch(0.7034 0.1227 78.072)'],
    vars: { '--color-primary': 'oklch(0.3075 0.113 27.0778)', '--color-primary-light': 'oklch(0.3779 0.1355 26.6732)', '--color-accent': 'oklch(0.7034 0.1227 78.072)', '--color-accent-hover': 'oklch(0.6283 0.1163 76.5841)', '--border-accent': 'oklch(0.7034 0.1227 78.072 / 0.25)', '--shadow-accent': '0 8px 28px oklch(0.7034 0.1227 78.072 / 0.28)' } },
];

const FONTS = [
  { id: 'playfair-inter',       label: 'Playfair + Inter',       vars: { '--font-display': "'Playfair Display', Georgia, serif", '--font-body': "'Inter', system-ui, sans-serif" } },
  { id: 'fraunces-jakarta',     label: 'Fraunces + Jakarta',     vars: { '--font-display': "'Fraunces', Georgia, serif", '--font-body': "'Plus Jakarta Sans', system-ui, sans-serif" } },
  { id: 'cormorant-montserrat', label: 'Cormorant + Montserrat', vars: { '--font-display': "'Cormorant Garamond', Georgia, serif", '--font-body': "'Montserrat', system-ui, sans-serif" } },
  { id: 'baskerville-source',   label: 'Baskerville + Source',   vars: { '--font-display': "'Libre Baskerville', Georgia, serif", '--font-body': "'Source Sans 3', system-ui, sans-serif" } },
  { id: 'spectral-work',        label: 'Spectral + Work',        vars: { '--font-display': "'Spectral', Georgia, serif", '--font-body': "'Work Sans', system-ui, sans-serif" } },
];

const DEFAULT_SCHEME = 'charcoal-cyan';
const DEFAULT_FONT = 'spectral-work';

// Generate the per-section override rules from the data above (see SectionTheme.astro).
const ruleFor = (attr, id, vars) =>
  `[data-${attr}="${id}"]{${Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(';')}}`;
const themeOverrideCss = [
  ...SCHEMES.map((s) => ruleFor('scheme', s.id, s.vars)),
  ...FONTS.map((f) => ruleFor('font', f.id, f.vars)),
].join('\n');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>NYA TI — Option 3 (WIP)</title>

  <!-- Preload hero building base layers (see frontmatter). Starts the large
       webp fetch immediately at parse time so the building paints sooner and
       the un-pinned load window shrinks. -->
  {heroBaseImages.map((href) => (
    <link rel="preload" as="image" href={href} type="image/webp" fetchpriority="high" />
  ))}

  <!-- All font families used by the theme switcher must be loaded here -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Work+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    /* ─────────────────────────────────────
       Theme switcher bar
    ───────────────────────────────────── */
    .theme-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      background: oklch(0.1721 0.0324 268.8777);
      border-bottom: 1px solid oklch(1 0 0 / 0.1);
      padding: 0 40px;
      /* Auto-hide: slid up out of view; revealed on hover. */
      transform: translateY(-100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .theme-bar:hover,
    .theme-bar:focus-within {
      transform: translateY(0);
    }
    /* Invisible catcher strip + handle below the bar so it can be hovered
       back into view while hidden. */
    .theme-bar::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 22px;
    }
    .theme-bar::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 100%;
      transform: translateX(-50%);
      width: 46px;
      height: 4px;
      margin-top: 4px;
      border-radius: 0 0 3px 3px;
      background: oklch(0.1721 0.0324 268.8777);
      opacity: 0.55;
      transition: opacity 0.35s ease;
    }
    .theme-bar:hover::before,
    .theme-bar:focus-within::before {
      opacity: 0;
    }

    .theme-bar-inner {
      display: flex;
      align-items: stretch;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
      height: 56px;
    }
    .theme-bar-inner::-webkit-scrollbar { display: none; }

    .tb-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .tb-label {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: oklch(1 0 0 / 0.6);
      white-space: nowrap;
      flex-shrink: 0;
      margin-right: 6px;
    }

    .tb-divider {
      width: 1px;
      height: 28px;
      background: oklch(1 0 0 / 0.1);
      flex-shrink: 0;
      margin: 0 20px;
      align-self: center;
    }

    /* Color swatch buttons */
    .tb-color-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1.5px solid oklch(1 0 0 / 0.12);
      background: oklch(1 0 0 / 0.07);
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .tb-color-btn:hover {
      background: oklch(1 0 0 / 0.14);
      border-color: oklch(1 0 0 / 0.3);
      transform: translateY(-1px);
    }
    .tb-color-btn.active {
      background: oklch(1 0 0 / 0.18);
      border-color: oklch(1 0 0 / 0.6);
    }
    .tb-swatch {
      width: 16px;
      height: 16px;
      border-radius: 4px;
      border: 1px solid oklch(0 0 0 / 0.3);
      flex-shrink: 0;
    }
    .tb-scheme-name {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 12px;
      font-weight: 500;
      color: oklch(1 0 0);
      white-space: nowrap;
    }
    .tb-color-btn.active .tb-scheme-name {
      color: oklch(1 0 0);
      font-weight: 700;
    }

    /* Font buttons */
    .tb-font-btn {
      padding: 6px 14px;
      border-radius: 8px;
      border: 1.5px solid oklch(1 0 0 / 0.2);
      background: oklch(1 0 0 / 0.08);
      cursor: pointer;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 12px;
      font-weight: 500;
      color: oklch(1 0 0);
      white-space: nowrap;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .tb-font-btn:hover {
      background: oklch(1 0 0 / 0.16);
      border-color: oklch(1 0 0 / 0.4);
      transform: translateY(-1px);
    }
    .tb-font-btn.active {
      background: oklch(1 0 0 / 0.22);
      border-color: oklch(1 0 0);
      font-weight: 700;
    }

    .tb-page-label {
      margin-left: auto;
      flex-shrink: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: oklch(1 0 0 / 0.35);
      padding-left: 24px;
      align-self: center;
    }

    @media (max-width: 640px) {
      .theme-bar { padding: 0 16px; }
      .tb-scheme-name { display: none; }
    }
  </style>

  <!--
    Per-section theme overrides (see SectionTheme.astro).
    The switcher sets the GLOBAL default on :root; a section wrapped in
    <SectionTheme scheme="…" font="…"> re-declares the theme variables on its
    own subtree via these attribute rules. Generated from SCHEMES/FONTS above.
  -->
  <style is:global set:html={themeOverrideCss}></style>
</head>

<body>
  <BackToHub />
  <GlobalSetup client:load />

  <!-- ── Theme switcher bar ── -->
  <div class="theme-bar" id="theme-bar">
    <div class="theme-bar-inner">

      <div class="tb-group">
        <span class="tb-label">Color</span>
        <div class="tb-group" id="tb-colors" style="gap:4px;"></div>
      </div>

      <div class="tb-divider"></div>

      <div class="tb-group">
        <span class="tb-label">Font</span>
        <div class="tb-group" id="tb-fonts" style="gap:4px;"></div>
      </div>

      <span class="tb-page-label">Option 3 — WIP</span>
    </div>
  </div>

  <O3SideNav client:load />

  <!--
    ── Page sections ──
    Each section is wrapped in <SectionTheme>. Add scheme="…" and/or font="…"
    to override the global theme for that section; omit to inherit the global.
    Scheme ids:  navy-blue | slate-amber | charcoal-cyan | forest-stone
                 violet-gold | navy-gold | maroon-gold
    Font ids:    playfair-inter | fraunces-jakarta | cormorant-montserrat
                 baskerville-source | spectral-work
    Section overrides (e.g. section="hero") are defined in SectionTheme.astro.
  -->
  <main style="margin:0;padding:0">
    <SectionTheme>
      <O3Hero client:load />
    </SectionTheme>
    <SectionTheme section="ti-differences">
      <O3TIDifferences client:load />
    </SectionTheme>
    <SectionTheme>
      <O3FirmCulture client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3TrustWall client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3ClientCare client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3Ethos client:visible />
    </SectionTheme>
    <SectionTheme>
      <O3Footer client:load />
    </SectionTheme>
  </main>

  <script define:vars={{ SCHEMES, FONTS, DEFAULT_SCHEME, DEFAULT_FONT }}>
    /*
     * Theme switcher — sets CSS custom properties on :root from the SCHEMES /
     * FONTS data defined in this file's frontmatter (single source of truth).
     */
    function setActive(btnClass, id) {
      document.querySelectorAll('.' + btnClass).forEach((btn) =>
        btn.classList.toggle('active', btn.dataset.id === id)
      );
    }

    function applyVars(list, id) {
      const item = list.find((x) => x.id === id);
      if (!item) return null;
      const root = document.documentElement;
      Object.entries(item.vars).forEach(([k, v]) => root.style.setProperty(k, v));
      return item;
    }

    function applyScheme(id) {
      if (!applyVars(SCHEMES, id)) return;
      setActive('tb-color-btn', id);
      window.dispatchEvent(new CustomEvent('themechange'));
    }

    function applyFont(id) {
      if (!applyVars(FONTS, id)) return;
      setActive('tb-font-btn', id);
    }

    function addButton(parent, item, btnClass, onClick, decorate) {
      const btn = document.createElement('button');
      btn.className = btnClass;
      btn.dataset.id = item.id;
      decorate(btn);
      btn.addEventListener('click', onClick);
      parent.appendChild(btn);
    }

    function buildSwitcher() {
      const colorsEl = document.getElementById('tb-colors');
      const fontsEl = document.getElementById('tb-fonts');
      if (!colorsEl || !fontsEl) return;

      SCHEMES.forEach((scheme) =>
        addButton(colorsEl, scheme, 'tb-color-btn', () => applyScheme(scheme.id), (btn) => {
          btn.title = scheme.name;
          btn.innerHTML =
            scheme.swatches.map((c) => `<span class="tb-swatch" style="background:${c};"></span>`).join('') +
            `<span class="tb-scheme-name">${scheme.name}</span>`;
        })
      );

      FONTS.forEach((font) =>
        addButton(fontsEl, font, 'tb-font-btn', () => applyFont(font.id), (btn) => {
          btn.textContent = font.label;
        })
      );

      applyScheme(DEFAULT_SCHEME);
      applyFont(DEFAULT_FONT);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', buildSwitcher);
    } else {
      buildSwitcher();
    }
  </script>
</body>
</html>
