---
/*
 * option3.astro — TI Page Option 3 (WIP / Skeleton)
 *
 * Theme switcher bar at top lets you toggle color scheme and font pair.
 * All components read CSS variables from :root — they react to changes automatically.
 *
 * Color schemes: navy-blue | slate-amber | charcoal-cyan | forest-stone | violet-gold | navy-gold | maroon-gold
 * Font pairs:    playfair-inter | fraunces-jakarta | cormorant-montserrat | baskerville-source | spectral-work
 */
import '../index.css';
import GlobalSetup from '../components/GlobalSetup/GlobalSetup';
import Hero4 from '../components/Hero4/Hero4.jsx';
import TIDifferencesOption3 from '../components/ti-option3/TIDifferences/TIDifferencesOption3';
import FirmCultureOption3 from '../components/ti-option3/FirmCultureOption3';
import CTAOption3 from '../components/ti-option3/CTAOption3';
import CaringFirmOption3 from '../components/ti-option3/CaringFirmOption3';
import TrustWallOption3 from '../components/ti-option3/TrustWallOption3';
import SideNavOption3 from '../components/ti-option3/SideNavOption3';
import NYACulture from '../components/NYACulture/NYACulture.jsx';
import NYACulture2 from '../components/NYACulture2/NYACulture2.jsx';
import Footer from '../components/Footer/Footer.jsx';
import BackToHub from '../components/BackToHub.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>NYA TI — Option 3 (WIP)</title>

  <!-- All font families used by the theme switcher must be loaded here -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Work+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    /* ─────────────────────────────────────
       Theme switcher bar
    ───────────────────────────────────── */
    .theme-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      background: #0a0f1e;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0 40px;
      /* Auto-hide: slid up out of view; revealed on hover. */
      transform: translateY(-100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .theme-bar:hover,
    .theme-bar:focus-within {
      transform: translateY(0);
    }
    /* Invisible catcher strip + handle below the bar so it can be hovered
       back into view while hidden. */
    .theme-bar::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 22px;
    }
    .theme-bar::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 100%;
      transform: translateX(-50%);
      width: 46px;
      height: 4px;
      margin-top: 4px;
      border-radius: 0 0 3px 3px;
      background: #0a0f1e;
      opacity: 0.55;
      transition: opacity 0.35s ease;
    }
    .theme-bar:hover::before,
    .theme-bar:focus-within::before {
      opacity: 0;
    }

    .theme-bar-inner {
      display: flex;
      align-items: stretch;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
      height: 56px;
    }
    .theme-bar-inner::-webkit-scrollbar { display: none; }

    .tb-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .tb-label {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      white-space: nowrap;
      flex-shrink: 0;
      margin-right: 6px;
    }

    .tb-divider {
      width: 1px;
      height: 28px;
      background: rgba(255, 255, 255, 0.1);
      flex-shrink: 0;
      margin: 0 20px;
      align-self: center;
    }

    /* Color swatch buttons */
    .tb-color-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.07);
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .tb-color-btn:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-1px);
    }
    .tb-color-btn.active {
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.6);
    }
    .tb-swatch {
      width: 16px;
      height: 16px;
      border-radius: 4px;
      border: 1px solid rgba(0, 0, 0, 0.3);
      flex-shrink: 0;
    }
    .tb-scheme-name {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 12px;
      font-weight: 500;
      color: #fff;
      white-space: nowrap;
    }
    .tb-color-btn.active .tb-scheme-name {
      color: #fff;
      font-weight: 700;
    }

    /* Font buttons */
    .tb-font-btn {
      padding: 6px 14px;
      border-radius: 8px;
      border: 1.5px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.08);
      cursor: pointer;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 12px;
      font-weight: 500;
      color: #fff;
      white-space: nowrap;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .tb-font-btn:hover {
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.4);
      transform: translateY(-1px);
    }
    .tb-font-btn.active {
      background: rgba(255, 255, 255, 0.22);
      border-color: #fff;
      font-weight: 700;
    }

    .tb-page-label {
      margin-left: auto;
      flex-shrink: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.35);
      padding-left: 24px;
      align-self: center;
    }

    @media (max-width: 640px) {
      .theme-bar { padding: 0 16px; }
      .tb-scheme-name { display: none; }
    }
  </style>
</head>

<body>
  <BackToHub />
  <GlobalSetup client:load />

  <!-- ── Theme switcher bar ── -->
  <div class="theme-bar" id="theme-bar">
    <div class="theme-bar-inner">

      <div class="tb-group">
        <span class="tb-label">Color</span>
        <div class="tb-group" id="tb-colors" style="gap:4px;"></div>
      </div>

      <div class="tb-divider"></div>

      <div class="tb-group">
        <span class="tb-label">Font</span>
        <div class="tb-group" id="tb-fonts" style="gap:4px;"></div>
      </div>

      <span class="tb-page-label">Option 3 — WIP</span>
    </div>
  </div>

  <SideNavOption3 client:load />

  <!-- ── Page sections ── -->
  <main style="margin:0;padding:0">
    <Hero4 client:load />
    <TIDifferencesOption3 client:load />
    <FirmCultureOption3 client:visible />
    <TrustWallOption3 client:visible />
    <CaringFirmOption3 client:visible />
    <CTAOption3 client:visible />
    <NYACulture2 client:visible />
    <NYACulture client:visible />
    <Footer client:load />
  </main>

  <script>
    /*
     * Theme switcher — sets CSS custom properties on :root.
     * All components use var(--color-primary), var(--font-display), etc.
     * Adding a new scheme: add an entry to SCHEMES below. No other changes needed.
     */

    const SCHEMES = [
      {
        id: 'navy-blue', name: 'NB',
        swatches: ['#0B1F3B', '#2F80ED'],
        vars: {
          '--color-primary':       '#0B1F3B',
          '--color-primary-light': '#1E3A5F',
          '--color-accent':        '#2F80ED',
          '--color-accent-hover':  '#1C6ED5',
          '--border-accent':       'rgba(47,128,237,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(47,128,237,0.28)',
        },
      },
      {
        id: 'slate-amber', name: 'SA',
        swatches: ['#1F2937', '#D97706'],
        vars: {
          '--color-primary':       '#1F2937',
          '--color-primary-light': '#374151',
          '--color-accent':        '#D97706',
          '--color-accent-hover':  '#B45309',
          '--border-accent':       'rgba(217,119,6,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(217,119,6,0.28)',
        },
      },
      {
        id: 'charcoal-cyan', name: 'CC',
        swatches: ['#0F172A', '#06B6D4'],
        vars: {
          '--color-primary':       '#0F172A',
          '--color-primary-light': '#1E293B',
          '--color-accent':        '#06B6D4',
          '--color-accent-hover':  '#0891B2',
          '--border-accent':       'rgba(6,182,212,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(6,182,212,0.28)',
        },
      },
      {
        id: 'forest-stone', name: 'FS',
        swatches: ['#1A2E1A', '#6B9B6B'],
        vars: {
          '--color-primary':       '#1A2E1A',
          '--color-primary-light': '#2D4A2D',
          '--color-accent':        '#6B9B6B',
          '--color-accent-hover':  '#5A8A5A',
          '--border-accent':       'rgba(107,155,107,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(107,155,107,0.28)',
        },
      },
      {
        id: 'violet-gold', name: 'V',
        swatches: ['#1E1B4B', '#7C3AED'],
        vars: {
          '--color-primary':       '#1E1B4B',
          '--color-primary-light': '#4C1D95',
          '--color-accent':        '#7C3AED',
          '--color-accent-hover':  '#6D28D9',
          '--border-accent':       'rgba(124,58,237,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(124,58,237,0.28)',
        },
      },
      {
        id: 'navy-gold', name: 'NG',
        swatches: ['#1E3A8A', '#B45309'],
        vars: {
          '--color-primary':       '#1E3A8A',
          '--color-primary-light': '#1E40AF',
          '--color-accent':        '#B45309',
          '--color-accent-hover':  '#92400E',
          '--border-accent':       'rgba(180,83,9,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(180,83,9,0.28)',
        },
      },
      {
        id: 'maroon-gold', name: 'MG',
        swatches: ['#5C0B0B', '#C9953A'],
        vars: {
          '--color-primary':       '#5C0B0B',
          '--color-primary-light': '#7A1515',
          '--color-accent':        '#C9953A',
          '--color-accent-hover':  '#B07E28',
          '--border-accent':       'rgba(201,149,58,0.25)',
          '--shadow-accent':       '0 8px 28px rgba(201,149,58,0.28)',
        },
      },
    ];

    const FONTS = [
      {
        id: 'playfair-inter', label: 'Playfair + Inter',
        displayFamily: "'Playfair Display', Georgia, serif",
        bodyFamily:    "'Inter', system-ui, sans-serif",
      },
      {
        id: 'fraunces-jakarta', label: 'Fraunces + Jakarta',
        displayFamily: "'Fraunces', Georgia, serif",
        bodyFamily:    "'Plus Jakarta Sans', system-ui, sans-serif",
      },
      {
        id: 'cormorant-montserrat', label: 'Cormorant + Montserrat',
        displayFamily: "'Cormorant Garamond', Georgia, serif",
        bodyFamily:    "'Montserrat', system-ui, sans-serif",
      },
      {
        id: 'baskerville-source', label: 'Baskerville + Source',
        displayFamily: "'Libre Baskerville', Georgia, serif",
        bodyFamily:    "'Source Sans 3', system-ui, sans-serif",
      },
      {
        id: 'spectral-work', label: 'Spectral + Work',
        displayFamily: "'Spectral', Georgia, serif",
        bodyFamily:    "'Work Sans', system-ui, sans-serif",
      },
    ];

    let activeScheme = 'navy-blue';
    let activeFont   = 'playfair-inter';

    function applyScheme(id: string) {
      const scheme = SCHEMES.find(s => s.id === id);
      if (!scheme) return;
      const root = document.documentElement;
      Object.entries(scheme.vars).forEach(([k, v]) => root.style.setProperty(k, v));
      activeScheme = id;
      document.querySelectorAll<HTMLButtonElement>('.tb-color-btn').forEach(btn =>
        btn.classList.toggle('active', btn.dataset.id === id)
      );
      window.dispatchEvent(new CustomEvent('themechange'));
    }

    function applyFont(id: string) {
      const font = FONTS.find(f => f.id === id);
      if (!font) return;
      const root = document.documentElement;
      root.style.setProperty('--font-display', font.displayFamily);
      root.style.setProperty('--font-body',    font.bodyFamily);
      activeFont = id;
      document.querySelectorAll<HTMLButtonElement>('.tb-font-btn').forEach(btn =>
        btn.classList.toggle('active', btn.dataset.id === id)
      );
    }

    function buildSwitcher() {
      const colorsEl = document.getElementById('tb-colors');
      const fontsEl  = document.getElementById('tb-fonts');
      if (!colorsEl || !fontsEl) return;

      SCHEMES.forEach(scheme => {
        const btn = document.createElement('button');
        btn.className = 'tb-color-btn';
        btn.dataset.id = scheme.id;
        btn.title = scheme.name;
        btn.innerHTML = scheme.swatches.map(c =>
          `<span class="tb-swatch" style="background:${c};"></span>`
        ).join('') + `<span class="tb-scheme-name">${scheme.name}</span>`;
        btn.addEventListener('click', () => applyScheme(scheme.id));
        colorsEl.appendChild(btn);
      });

      FONTS.forEach(font => {
        const btn = document.createElement('button');
        btn.className = 'tb-font-btn';
        btn.dataset.id = font.id;
        btn.textContent = font.label;
        btn.addEventListener('click', () => applyFont(font.id));
        fontsEl.appendChild(btn);
      });

      // Apply defaults
      applyScheme(activeScheme);
      applyFont(activeFont);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', buildSwitcher);
    } else {
      buildSwitcher();
    }
  </script>
</body>
</html>
